# ============================================================
#  Phantoms API - Environment Variables
#  1. Copy this file:  cp .env.example .env
#  2. Fill in the values below
#  3. NEVER commit .env to git!
# ============================================================

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=PhantomsDb
POSTGRES_USER=phantoms_user
POSTGRES_PASSWORD=change_me_strong_password

# ── Connection String (used by the API) ─────────────────────
# Format: Host=postgres;Port=5432;Database=...;Username=...;Password=...
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=PhantomsDb;Username=phantoms_user;Password=change_me_strong_password

# ── JWT ──────────────────────────────────────────────────────
# Key must be at least 32 characters long!
JwtSettings__Key=CHANGE_ME_super_secret_jwt_key_at_least_32_chars
JwtSettings__Issuer=PhantomsAPI
JwtSettings__Audience=PhantomsClients
JwtSettings__AccessTokenExpirationMinutes=60
JwtSettings__RefreshTokenExpirationDays=7

# ── SMTP (optional - leave blank to disable email) ───────────
SmtpSettings__Host=smtp.gmail.com
SmtpSettings__Port=587
SmtpSettings__UserName=your_email@gmail.com
SmtpSettings__Password=your_app_password
SmtpSettings__FromEmail=your_email@gmail.com
SmtpSettings__FromName=Phantoms
SmtpSettings__UseSsl=true

# ── Google OAuth (optional - leave blank to disable) ─────────
GoogleAuthSettings__ClientId=
GoogleAuthSettings__ClientSecret=

# ── General ──────────────────────────────────────────────────
ClientBaseUrl=http://localhost:3000
ASPNETCORE_ENVIRONMENT=Production
